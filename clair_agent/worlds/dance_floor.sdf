<?xml version="1.0"?>
<!--
  Empty world for Gazebo Fortress (Ignition Gazebo 6) with a differential-drive
  robot built to TurtleBot3 Burger dimensions (wheel radius 0.033 m, wheel
  separation 0.160 m). It is a geometric stand-in, not the ROBOTIS model: it
  lets the dance run where only Gazebo Fortress is installed. The official
  model comes from turtlebot3_gazebo (see tb3_dance.launch.py).
-->
<sdf version="1.8">
  <world name="dance_floor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="turtlebot3_burger">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <pose>-0.032 0 0.080 0 0 0</pose>
        <inertial>
          <mass>0.83</mass>
          <inertia>
            <ixx>0.0027</ixx><iyy>0.0027</iyy><izz>0.0027</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.140 0.140 0.140</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.140 0.140 0.140</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="lidar_visual">
          <pose>0 0 0.090 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.040</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.4 1</ambient>
            <diffuse>0.1 0.1 0.4 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wheel_left_link">
        <pose>0 0.080 0.033 -1.5708 0 0</pose>
        <inertial>
          <mass>0.0285</mass>
          <inertia>
            <ixx>1.1e-5</ixx><iyy>1.1e-5</iyy><izz>2.1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wheel_right_link">
        <pose>0 -0.080 0.033 -1.5708 0 0</pose>
        <inertial>
          <mass>0.0285</mass>
          <inertia>
            <ixx>1.1e-5</ixx><iyy>1.1e-5</iyy><izz>2.1e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="caster_back_link">
        <pose>-0.081 0 0.005 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.005</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.005</radius></sphere></geometry>
        </visual>
      </link>

      <joint name="wheel_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_left_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="wheel_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_right_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="caster_back_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster_back_link</child>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.160</wheel_separation>
        <wheel_radius>0.033</wheel_radius>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
